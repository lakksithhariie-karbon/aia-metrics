{
  "name": "aia-product-overview-shell",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack --hostname 0.0.0.0 --port 8953",
    "prebuild": "node scripts/verify-overview-drill-contract.mjs && node scripts/verify-companies-drill-contract.mjs && node scripts/verify-delivery-shell.mjs && node scripts/verify-assignee-overview.mjs && node scripts/verify-jira-foundation.mjs && node scripts/verify-jira-reporting-integrity.mjs && node scripts/verify-retention-range.mjs && node scripts/verify-section-navigation.mjs && node scripts/verify-infra-shell.mjs",
    "build": "next build --webpack",
    "test:overview-drills": "node scripts/verify-overview-drill-contract.mjs",
    "start": "next start --hostname 0.0.0.0 --port 8953",
    "typecheck": "tsc --noEmit",
    "typecheck:edge": "tsc --noEmit --strict --skipLibCheck --target es2022 --module esnext --moduleResolution bundler --lib es2022,dom supabase/functions/companies-dashboard/edge-check.d.ts supabase/functions/companies-dashboard/index.ts",
    "test:companies-drill": "node scripts/verify-companies-drill-contract.mjs",
    "test:delivery-shell": "node scripts/verify-delivery-shell.mjs",
    "test:jira-foundation": "node scripts/verify-jira-foundation.mjs",
    "test:jira-reporting": "node scripts/verify-jira-reporting-integrity.mjs",
    "test:assignees": "node scripts/verify-assignee-overview.mjs",
    "test:retention-range": "node scripts/verify-retention-range.mjs",
    "test:section-navigation": "node scripts/verify-section-navigation.mjs",
    "test:infra-shell": "node scripts/verify-infra-shell.mjs"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0"
  }
}
